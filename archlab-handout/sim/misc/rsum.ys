##################################################################
# rsum.ys
# long rsum_list(list_ptr ls)
#{
#    if (!ls)
#        return 0;
#
#    long val = ls->val;
#    long rest = rsum_list(ls->next);
#    return val + rest;
#}
##################################################################

.pos 0
    irmovq Stack, %rsp      # 初始化栈
    irmovq ele1, %rdi       # 第一个参数：链表首地址
    call rsum_list
    halt

##################################################################
# long rsum_list(list_ptr ls)
# %rdi = ls
# %rax = sum
##################################################################
rsum_list:
    xorq %rax,%rax # rax=0
    andq %rdi,%rdi
    je Done
    mrmovq 0(%rdi),%r10
    pushq %r10
    mrmovq 8(%rdi),%rdi
    call rsum_list
    popq %r10
    addq %r10,%rax
    ret
Done:
    ret

##################################################################
# 测试链表
##################################################################
.align 8
ele1:
    .quad 0x00a
    .quad ele2

ele2:
    .quad 0x0b0
    .quad ele3

ele3:
    .quad 0xc00
    .quad 0

##################################################################
# 栈
##################################################################
.pos 0x200
Stack:
