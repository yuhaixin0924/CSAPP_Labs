##################################################################
# sum.ys
# Name:
# ID:
##################################################################

.pos 0
    irmovq Stack, %rsp      # 初始化栈
    irmovq ele1, %rdi       # 第一个参数：链表首地址
    call sum_list
    halt

##################################################################
# long sum_list(list_ptr ls)
# %rdi = ls
# %rax = sum
##################################################################
sum_list:
    xorq %rax, %rax         # sum = 0

Loop:
    andq %rdi,%rdi
    je Done
    mrmovq 0(%rdi),%r10
    addq %r10,%rax 
    mrmovq 8(%rdi),%rdi
    jmp Loop

Done:
    ret

##################################################################
# 测试链表
##################################################################
.align 8
ele1:
    .quad 0x00a
    .quad ele2

ele2:
    .quad 0x0b0
    .quad ele3

ele3:
    .quad 0xc00
    .quad 0

##################################################################
# 栈
##################################################################
.pos 0x200
Stack:
