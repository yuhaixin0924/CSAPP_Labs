#/* $begin ncopy-ys */
##################################################################
# ncopy.ys - Copy a src block of len words to dst.
# Return the number of positive words (>0) contained in src.
#
# Include your name and ID here.
#
# Describe how and why you modified the baseline code.
#
##################################################################
# Do not modify this portion
# Function prologue.
# %rdi = src, %rsi = dst, %rdx = len
ncopy:

##################################################################
# You can modify this portion
	# Loop header
	xorq %rax,%rax		# count = 0;
	andq %rdx,%rdx		# len <= 0?
	jle Done		# if so, goto Done:
	iaddq $-4, %rdx 	# len-2
	jl TailCheck #提前检查是否还有可以处理的空间

Loop4:	
	mrmovq (%rdi), %r8	# read val from src...
	mrmovq 8(%rdi), %r9
	mrmovq 16(%rdi),%r10
	mrmovq 24(%rdi),%r11

	rmmovq %r8,0(%rsi)	# ...and store it to dst
	rmmovq %r9,8(%rsi)
	rmmovq %r10,16(%rsi)
	rmmovq %r11,24(%rsi)

	andq %r8, %r8		# val <= 0?
	jle Npos1		# if so, goto Npos:
	iaddq $1, %rax	# 优化替换常数操作 count++
Npos1:
	andq %r9, %r9
	jle Npos2
	iaddq $1, %rax
Npos2:
	andq %r10, %r10
	jle Npos3
	iaddq $1, %rax
Npos3:
	andq %r11, %r11
	jle Npos4
	iaddq $1, %rax
Npos4:
	iaddq $32, %rdi	
	iaddq $32,%rsi

	iaddq $-4, %rdx 	# len-4
	jge Loop4			# if so, goto Loop:
	jmp TailCheck

TailCheck:
	iaddq $4,%rdx
	je Done

	iaddq $-2,%rdx
	je Tail2
	jl Tail1
Tail3:
	mrmovq 16(%rdi),%r10
	rmmovq %r10,16(%rsi)

	andq %r10,%r10
	jle Tail2
	iaddq $1,%rax
Tail2:
	mrmovq 8(%rdi),%r10
	rmmovq %r10,8(%rsi)

	andq %r10,%r10
	jle Tail1
	iaddq $1,%rax
Tail1:
	mrmovq 0(%rdi),%r10
	rmmovq %r10,0(%rsi)

	andq %r10,%r10
	jle Done
	iaddq $1,%rax
##################################################################
# Do not modify the following section of code
# Function epilogue.
Done:
	ret
##################################################################
# Keep the following label at the end of your function
End:
#/* $end ncopy-ys */
