#/* $begin ncopy-ys */
##################################################################
# ncopy.ys - Copy a src block of len words to dst.
# Return the number of positive words (>0) contained in src.
#
# Include your name and ID here.
#
# Describe how and why you modified the baseline code.
#
##################################################################
# Do not modify this portion
# Function prologue.
# %rdi = src, %rsi = dst, %rdx = len
ncopy:

##################################################################
# You can modify this portion
	# Loop header
	xorq %rax,%rax		# count = 0;
	andq %rdx,%rdx		# len <= 0?
	jle Done		# if so, goto Done:
	iaddq $-8, %rdx 	# len-8
	jl TailCheck #提前检查是否还有可以处理的空间

Loop8:	
	mrmovq (%rdi), %r8	# read val from src...
	mrmovq 8(%rdi), %r9
	mrmovq 16(%rdi),%r10
	mrmovq 24(%rdi),%r11
    mrmovq 32(%rdi),%r12
    mrmovq 40(%rdi),%r13
    mrmovq 48(%rdi),%r14
    mrmovq 56(%rdi),%rcx

	rmmovq %r8,0(%rsi)	# ...and store it to dst
	rmmovq %r9,8(%rsi)
	rmmovq %r10,16(%rsi)
	rmmovq %r11,24(%rsi)
    rmmovq %r12,32(%rsi)
    rmmovq %r13,40(%rsi)
    rmmovq %r14,48(%rsi)
    rmmovq %rcx,56(%rsi)

	andq %r8, %r8		# val <= 0?
	jle Npos1		# if so, goto Npos:
	iaddq $1, %rax	# 优化替换常数操作 count++
Npos1:
	andq %r9, %r9
	jle Npos2
	iaddq $1, %rax
Npos2:
	andq %r10, %r10
	jle Npos3
	iaddq $1, %rax
Npos3:
	andq %r11, %r11
	jle Npos4
	iaddq $1, %rax
Npos4:
	andq %r12, %r12
	jle Npos5
	iaddq $1, %rax
Npos5:
	andq %r13, %r13
	jle Npos6
	iaddq $1, %rax
Npos6:
	andq %r14, %r14
	jle Npos7
	iaddq $1, %rax
Npos7:
	andq %rcx, %rcx
	jle Npos8
	iaddq $1, %rax
Npos8:
    iaddq $64, %rdi	
    iaddq $64, %rsi	

    iaddq $-8, %rdx 	# len-8
    jge Loop8			# if so, goto Loop:	

TailCheck:
	iaddq $8,%rdx
	je Done

	iaddq $-4,%rdx
    jl LessThan4
Tail4:
    mrmovq 0(%rdi), %r8	# read val from src...
	mrmovq 8(%rdi), %r9
	mrmovq 16(%rdi),%r10
	mrmovq 24(%rdi),%r11

	rmmovq %r8,0(%rsi)	# ...and store it to dst
	rmmovq %r9,8(%rsi)
	rmmovq %r10,16(%rsi)
	rmmovq %r11,24(%rsi)

	andq %r8, %r8		# val <= 0?
	jle Tail4Npos1		# if so, goto Npos:
	iaddq $1, %rax	# 优化替换常数操作 count++
Tail4Npos1:
	andq %r9, %r9
	jle Tail4Npos2
	iaddq $1, %rax
Tail4Npos2:
	andq %r10, %r10
	jle Tail4Npos3
	iaddq $1, %rax
Tail4Npos3:
	andq %r11, %r11
	jle Tail4Npos4
	iaddq $1, %rax
Tail4Npos4:
	iaddq $32,	%rdi	
	iaddq $32,	%rsi
	jmp Check2
LessThan4:
	iaddq $4, %rdx
Check2:
    iaddq $-2, %rdx
    jl LessThan2

Tail2:
	mrmovq 0(%rdi),%r10
	mrmovq 8(%rdi),%r11

	rmmovq %r10,0(%rsi)
	rmmovq %r11,8(%rsi)

	andq %r10,%r10
	jle Tail2Npos1
	iaddq $1,%rax
Tail2Npos1:
	andq %r11,%r11
	jle Tail2Npos2
	iaddq $1,%rax
Tail2Npos2:
	iaddq $16, %rdi
    iaddq $16, %rsi

	jmp Check1
LessThan2:
    iaddq $2, %rdx       # 不足2个，恢复真实余数0或1

Check1:
    andq %rdx, %rdx
    je Done
Tail1:
	mrmovq 0(%rdi),%r10
	rmmovq %r10,0(%rsi)
	
	andq %r10,%r10
	jle Done
	iaddq $1,%rax	

##################################################################
# Do not modify the following section of code
# Function epilogue.
Done:
	ret
##################################################################
# Keep the following label at the end of your function
End:
#/* $end ncopy-ys */

